{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/shop/",
	"features": {
		"networking": true
	},
	"extraLibraries": [ "wp-cli" ],
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "woocommerce"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "tax-switch-for-woocommerce"
			},
			"ifAlreadyInstalled": "skip"
		},
		{
			"step": "activatePlugin",
			"pluginPath": "tax-switch-for-woocommerce/wdevs-tax-switch.php"
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/mu-plugins"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/tax-switch-for-woocommerce-demo.php",
			"data": "<?php\n$get_tax_switch = function () {\n\treturn do_shortcode( '[wdevs_tax_switch switch-label-incl=\"Incl. VAT\" switch-label-excl=\"Excl. VAT\" switch-aria-label=\"Switch between prices including and excluding tax\"]' );\n};\nadd_action( 'woocommerce_before_shop_loop', function () use ( $get_tax_switch ) {\n\techo $get_tax_switch();\n}, 5 );\nadd_action( 'woocommerce_single_product_summary', function () use ( $get_tax_switch ) {\n\techo $get_tax_switch();\n}, 15 );\nadd_filter( 'get_pages_query_args', function ( $args ) {\n\tif ( ! is_admin() ) {\n\t\t$sample_page = get_page_by_path( 'sample-page' );\n\t\t$args['post__not_in'] = array_merge( $args['post__not_in'] ?? array(), array_map( 'intval', array( get_option( 'woocommerce_cart_page_id' ), get_option( 'woocommerce_checkout_page_id' ), get_option( 'woocommerce_myaccount_page_id' ), $sample_page ? $sample_page->ID : 0 ) ) );\n\t}\n\treturn $args;\n} );\nadd_action( 'wp_body_open', function () {\n\techo '<aside role=\"complementary\" aria-label=\"Tax Switch for WooCommerce\" style=\"box-sizing:border-box;width:100%;padding:.75rem 1rem;text-align:center;background:#1e1e1e;color:#fff\">👋 Questions or want to learn more? <a href=\"https://products.wijnberg.dev/product/wordpress/plugins/tax-switch-for-woocommerce/\" style=\"color:inherit;font-weight:600\">Explore Tax Switch for WooCommerce →</a></aside>';\n} );\n"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Tax Switch for WooCommerce Demo",
				"woocommerce_default_country": "NL",
				"woocommerce_currency": "EUR",
				"woocommerce_calc_taxes": "yes",
				"woocommerce_tax_based_on": "base",
				"woocommerce_default_customer_address": "base",
				"woocommerce_allow_tracking": "no",
				"woocommerce_coming_soon": "no",
				"permalink_structure": "/%postname%/"
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "vfs",
				"path": "/wordpress/wp-content/plugins/woocommerce/sample-data/sample_products.xml"
			}
		},
		{
			"step": "wp-cli",
			"command": "wp post create --post_type=page --post_status=publish --post_title='Customize the Tax Switch' --post_name=customize --import_id=100 --post_content='<!-- wp:paragraph --><p>Select the Tax Switch block and use the settings sidebar to change its type, colors, and labels.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/wp-admin/post.php?post=100&amp;action=edit\">Open the block editor</a></div><!-- /wp:button --></div><!-- /wp:buttons --><!-- wp:wdevs/tax-switch --><div class=\"wp-block-wdevs-tax-switch\"></div><!-- /wp:wdevs/tax-switch --><!-- wp:shortcode -->[products limit=\"8\" columns=\"4\"]<!-- /wp:shortcode -->'"
		},
		{
			"step": "wp-cli",
			"command": "wp wc tax create --user=1 --country=NL --rate=21 --name=VAT --shipping=true"
		},
		{
			"step": "wp-cli",
			"command": "wp rewrite flush"
		}
	]
}
